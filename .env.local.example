# Optional shell settings for scripts/local-env.sh. Copy to .env.local.
# .env.local is ignored by Git; do not put credentials in this example.

# Directory containing Node.js 24.11+ and npm, when they are not on PATH.
# PAPERCLIP_LOCAL_NODE_BIN="$HOME/path/to/node/bin"

PAPERCLIP_LOCAL_DATA_DIR=.paperclip-local
PAPERCLIP_LOCAL_PORT=3100

# Optional HTTP proxy for package downloads and local agent subprocesses.
# PAPERCLIP_LOCAL_PROXY=http://127.0.0.1:7897
